# Скопируйте этот файл в .env и заполните значения.

# Токен бота от @BotFather (обязательно)
BOT_TOKEN=

# Username бота без @ (например: nizkiyprofil_bot). Нужен для ссылки отслеживания на сайте.
BOT_USERNAME=

# Куда присылать заявки. Узнать свой ID: напишите боту команду /id.
# Можно несколько через запятую: 111111111,222222222
OWNER_CHAT_ID=

# Порт веб-сервера (5000 локально, 8080 на VPS в Docker)
PORT=5000

# Публичный адрес сайта (для SEO: canonical, sitemap, Open Graph).
# На VPS укажите: SITE_URL=https://nizkiyprofil.ru
SITE_URL=

# Яндекс.Метрика: номер счётчика. Загружается только после согласия пользователя на cookie.
YANDEX_METRIKA_ID=

# Дополнительные адреса, с которых форме разрешено обращаться к /api/ (через запятую).
# Свой SITE_URL и localhost разрешены всегда. Нужно только если сайт открыт
# на другом домене, например через временный туннель ngrok.
# CORS_ORIGINS=https://example.ngrok-free.app

# Напоминание о визите (пока без SMS — только лог + уведомление владельцу в Telegram)
REMINDER_HOURS=5
REMINDER_CHECK_SEC=60

# SMS.ru — подключите позже (api_id из личного кабинета)
# SMS_API_ID=

# Если api.telegram.org недоступен — прокси, например socks5://127.0.0.1:1080
# TELEGRAM_PROXY=
