# Скопируйте этот файл в .env и заполните значения.

# Токен бота от @BotFather (обязательно)
BOT_TOKEN=

# Username бота без @ (например: nizkiyprofil_bot). Нужен для ссылки отслеживания на сайте.
BOT_USERNAME=

# Куда присылать заявки. Узнать свой ID: напишите боту команду /id.
# Можно несколько через запятую: 111111111,222222222
OWNER_CHAT_ID=

# Порт веб-сервера (5000 локально, 8080 на VPS в Docker)
PORT=5000

# Публичный адрес сайта (для SEO: canonical, sitemap, Open Graph).
# На VPS укажите: SITE_URL=https://nizkiyprofil.ru
SITE_URL=

# Яндекс.Метрика: номер счётчика. Загружается только после согласия пользователя на cookie.
YANDEX_METRIKA_ID=
